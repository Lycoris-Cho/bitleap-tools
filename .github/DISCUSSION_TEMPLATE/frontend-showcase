title: "[作品] "

body:
  - type: markdown
    attributes:
      value: |
        ## 🎨 分享你的前端作品

        欢迎分享你制作的网站、组件、页面、交互实验或完整项目。

        请尽量填写完整的信息，方便大家了解你的作品。

  - type: input
    id: project_name
    attributes:
      label: 作品名称
      description: 你的项目或作品叫什么？
      placeholder: 例如：Music Glass
    validations:
      required: true

  - type: textarea
    id: description
    attributes:
      label: 作品介绍
      description: 简单介绍一下这个作品做了什么
      placeholder: |
        这个项目主要用于……
        我制作它是因为……
    validations:
      required: true

  - type: input
    id: demo_url
    attributes:
      label: 在线体验地址
      description: 如果已经部署，可以填写在线地址
      placeholder: https://example.com
    validations:
      required: false

  - type: input
    id: github_url
    attributes:
      label: GitHub 地址
      description: 如果项目开源，可以填写仓库地址
      placeholder: https://github.com/username/repository
    validations:
      required: false

  - type: input
    id: tech_stack
    attributes:
      label: 技术栈
      description: 项目使用了哪些技术？
      placeholder: Next.js, React, Tailwind CSS, TypeScript
    validations:
      required: false

  - type: textarea
    id: highlights
    attributes:
      label: 项目亮点
      description: 有什么值得分享的设计或技术实现？
      placeholder: |
        - 响应式布局
        - 动态背景
        - Canvas 图片处理
        - 自定义播放器
    validations:
      required: false

  - type: textarea
    id: screenshots
    attributes:
      label: 项目截图
      description: 可以直接拖拽或粘贴图片到这里
    validations:
      required: false

  - type: checkboxes
    id: agreement
    attributes:
      label: 发布确认
      options:
        - label: 我确认该内容是本人作品或拥有分享权限
          required: true
